root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.rs]
indent_size = 4

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.sh]
indent_size = 2

[justfile]
indent_style = space
indent_size = 4

[*.md]
indent_size = unset
trim_trailing_whitespace = false
