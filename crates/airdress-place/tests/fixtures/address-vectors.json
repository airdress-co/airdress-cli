{
  "schema": 1,
  "about": "The map address grammar (the URL fragment of maps.airdress.co) as cases. The page's formatAddress/parseAddress and every other writer of a map link (the CLI's map_link) pass every case. Change the grammar here first.",
  "options": {
    "switches": {
      "regions": true,
      "counties": true,
      "cities": true,
      "names": true,
      "daynight": true,
      "satellites": false,
      "sat-stations": true,
      "sat-gnss": true,
      "sat-starlink": false,
      "sat-oneweb": false,
      "sat-kuiper": false,
      "sat-qianfan": false,
      "sat-guowang": false,
      "sat-tracks": false,
      "satellites-all": false,
      "reference-lines": true
    },
    "views": ["map", "terrain", "terrain3d", "satellite"],
    "modes": ["globe", "flat"],
    "defaultMode": "globe",
    "minZoom": 0,
    "maxZoom": 22,
    "maxPitch": 60,
    "asks": ["today", "sky"]
  },
  "cases": [
    {
      "name": "nothing to say",
      "op": "format",
      "state": {},
      "fragment": ""
    },
    {
      "name": "a camera at zoom 9: four decimals",
      "op": "format",
      "state": {
        "camera": {
          "lat": 50.7374,
          "lng": 7.0982,
          "zoom": 9
        }
      },
      "fragment": "#map=9/50.7374/7.0982"
    },
    {
      "name": "zoom rounded to two decimals, trailing zeros dropped",
      "op": "format",
      "state": {
        "camera": {
          "lat": 48.137154,
          "lng": 11.575382,
          "zoom": 12.5049
        }
      },
      "fragment": "#map=12.5/48.13715/11.57538"
    },
    {
      "name": "bearing alone is written with a zero pitch left off",
      "op": "format",
      "state": {
        "camera": {
          "lat": 50.7374,
          "lng": 7.0982,
          "zoom": 9,
          "bearing": 30
        }
      },
      "fragment": "#map=9/50.7374/7.0982/30"
    },
    {
      "name": "pitch alone writes a zero bearing before it",
      "op": "format",
      "state": {
        "camera": {
          "lat": 50.7374,
          "lng": 7.0982,
          "zoom": 9,
          "pitch": 45.4
        }
      },
      "fragment": "#map=9/50.7374/7.0982/0/45"
    },
    {
      "name": "bearing wraps into (-180, 180], -180 is 180",
      "op": "format",
      "state": {
        "camera": {
          "lat": 50.7374,
          "lng": 7.0982,
          "zoom": 9,
          "bearing": -180,
          "pitch": 10
        }
      },
      "fragment": "#map=9/50.7374/7.0982/180/10"
    },
    {
      "name": "a negative bearing halfway rounds toward +infinity (Math.round)",
      "op": "format",
      "state": {
        "camera": {
          "lat": 50.7374,
          "lng": 7.0982,
          "zoom": 9,
          "bearing": -12.25
        }
      },
      "fragment": "#map=9/50.7374/7.0982/-12.2"
    },
    {
      "name": "a longitude past 180 wraps",
      "op": "format",
      "state": {
        "camera": {
          "lat": 10,
          "lng": 190,
          "zoom": 3
        }
      },
      "fragment": "#map=3/10/-170"
    },
    {
      "name": "one more latitude decimal past 75 degrees",
      "op": "format",
      "state": {
        "camera": {
          "lat": 78.2234567,
          "lng": 15.6412345,
          "zoom": 8
        }
      },
      "fragment": "#map=8/78.2235/15.641"
    },
    {
      "name": "an exact binary tie rounds up, as toFixed does",
      "op": "format",
      "state": {
        "camera": {
          "lat": 48.25,
          "lng": -48.25,
          "zoom": 0
        }
      },
      "fragment": "#map=0/48.3/-48.3"
    },
    {
      "name": "a camera at the pole on the globe",
      "op": "format",
      "state": {
        "camera": {
          "lat": 90,
          "lng": 0,
          "zoom": 1.5
        }
      },
      "fragment": "#map=1.5/90/0"
    },
    {
      "name": "a camera latitude past 90 is clamped",
      "op": "format",
      "state": {
        "camera": {
          "lat": 95,
          "lng": 0,
          "zoom": 2
        }
      },
      "fragment": "#map=2/90/0"
    },
    {
      "name": "view map is the default and left out",
      "op": "format",
      "state": {
        "view": "map"
      },
      "fragment": ""
    },
    {
      "name": "view satellite",
      "op": "format",
      "state": {
        "view": "satellite"
      },
      "fragment": "#view=satellite"
