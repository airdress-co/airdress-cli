#!/usr/bin/env bash
# Block direct pushes — all pushes must go through bot-commit.sh
# which sets AIRDRESS_PUSH_OVERRIDE=1 internally.
#
# To bypass in an emergency: AIRDRESS_PUSH_OVERRIDE=1 git push ...

if [ "${AIRDRESS_PUSH_OVERRIDE:-}" = "1" ]; then
    exit 0
fi

echo "error: direct push blocked — use bot-commit.sh instead" >&2
echo "       to override: AIRDRESS_PUSH_OVERRIDE=1 git push ..." >&2
exit 1
